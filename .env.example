# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used to read encrypted per-household Gemini keys. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default Gemini key used by every household that hasn't added its own (server only).
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=gemini-flash-latest

# 32-byte key, base64. Encrypts households' own Gemini keys at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Public URL of the app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
